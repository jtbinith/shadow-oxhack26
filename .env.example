# Copy to .env (never commit .env). Set values with: ./scripts/set-env.sh NAME

# Gemini (agent, move naming)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-4-argon

# Coach voice: Kokoro-82M (Hugging Face, open source, no key needed)
TTS_BACKEND=kokoro
TTS_VOICE_CALM=af_heart
TTS_VOICE_HYPE=am_puck

# Tiger Data (TimescaleDB + pgvector), full connection string incl. sslmode=require
DATABASE_URL=

# Clerk (login)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Hugging Face (deploys the Space)
HF_TOKEN=
HF_USERNAME=

# Vultr (optional later: provisioning, object storage). STORAGE_BACKEND=s3 to use it
STORAGE_BACKEND=local
VULTR_API_KEY=
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=shadow-uploads

# App
PUBLIC_HOSTNAME=
MAX_UPLOAD_MB=200
