# Copy to .env (never commit .env). Set values with: ./scripts/set-env.sh NAME

# Gemini (agent, move naming)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-4-argon

# ElevenLabs (coach voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_CALM=
ELEVENLABS_VOICE_ID_HYPE=

# Tiger Data (TimescaleDB + pgvector), full connection string incl. sslmode=require
DATABASE_URL=

# Clerk (login)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vultr (provisioning, object storage)
VULTR_API_KEY=
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=shadow-uploads

# App
PUBLIC_HOSTNAME=
MAX_UPLOAD_MB=200
